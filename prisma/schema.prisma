generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MEMBER
  ASSOCIATE
  TEACHER
  ADMIN
}

enum ResourceType {
  VIDEO
  PDF
  IMAGE
  LINK
  TEXT
}

enum PitchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum SaleKind {
  COURSE
  PRODUCT
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  TRANSFERRED
}

enum DonationStatus {
  PENDING
  PAID
}

enum ApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  googleId      String?   @unique
  role                 Role      @default(USER)
  paypalEmail          String?
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  enrollments    Enrollment[]
  coursesTaught  Course[]         @relation("CourseTeacher")
  lessonProgress LessonProgress[]
  profile        CreatorProfile?
  podcastPitches PodcastPitch[]
  products       Product[]
  purchases      Purchase[]
  blogPosts      BlogPost[]
  salesBought    Sale[]           @relation("SaleBuyer")
  salesSold      Sale[]           @relation("SaleSeller")
  subscriptions  PlatformSubscription[]
  payouts        MonthlyPayout[]
}

model CreatorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?
  niche        String?
  instagramUrl String?
  portfolioUrl String?
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PodcastPitch {
  id          String      @id @default(cuid())
  userId      String
  topic       String
  description String
  status      PitchStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id              String        @id @default(cuid())
  creatorId       String
  title           String
  description     String
  price           Float
  coverUrl        String?
  downloadUrl     String
  published       Boolean       @default(false)
  reviewStatus    ContentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  sales     Sale[]
}

model Purchase {
  id         String   @id @default(cuid())
  buyerId    String
  productId  String
  amountPaid Float
  valuxFee   Float
  createdAt  DateTime @default(now())

  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  price       Float    @default(0)
  coverUrl    String?
  published   Boolean  @default(false)
  teacherId   String?
  createdAt   DateTime @default(now())

  teacher     User?        @relation("CourseTeacher", fields: [teacherId], references: [id])
  sections    Section[]
  lessons     Lesson[]
  enrollments Enrollment[]
  sales       Sale[]
}

model Section {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id        String           @id @default(cuid())
  courseId  String
  sectionId String?
  slug      String
  title     String
  content   String
  videoUrl  String?
  points    Int              @default(10)
  duration  Int?
  order     Int              @default(0)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  resources Resource[]
  progress  LessonProgress[]

  @@unique([courseId, slug])
}

model Resource {
  id       String       @id @default(cuid())
  lessonId String
  type     ResourceType
  title    String
  url      String?
  content  String?
  order    Int          @default(0)
  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime  @default(now())
  score       Int?
  gradedAt    DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  finalGrade Int?
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model VerificationToken {
  token   String   @id
  email   String
  expires DateTime
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  authorId        String
  title           String
  excerpt         String
  body            String
  coverUrl        String?
  status          ContentStatus @default(DRAFT)
  rejectionReason String?
  publishedAt     DateTime?
  notifySentAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  confirmedAt  DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt    DateTime  @default(now())
}

model PlatformSettings {
  id                 String @id @default("valux")
  commissionPercent  Float  @default(30)
  subscriptionPrice  Float  @default(19)
  paypalClientHint   String?
}

model PlatformSubscription {
  id                   String             @id @default(cuid())
  userId               String
  status               SubscriptionStatus @default(ACTIVE)
  startedAt            DateTime           @default(now())
  currentPeriodEnd     DateTime
  paypalSubscriptionId String?
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sale {
  id             String   @id @default(cuid())
  kind           SaleKind
  buyerId        String
  sellerId       String?
  courseId       String?
  productId      String?
  amountPaid     Float
  valuxFee       Float
  sellerAmount   Float
  currency       String   @default("USD")
  paypalOrderId  String?  @unique
  paidAt         DateTime @default(now())
  periodYm       String
  createdAt      DateTime @default(now())

  buyer   User     @relation("SaleBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User?    @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model MembershipApplication {
  id               String            @id @default(cuid())
  email            String
  fullName         String
  photoUrl         String
  birthDate        String
  birthPlace       String
  nationality      String
  identityNumber   String
  gender           String
  maritalStatus    String
  address          String
  phone            String
  bloodType        String
  heightWeight     String?
  altContact       String
  favoriteColors   String
  favoriteFood     String
  favoriteDessert  String
  hobby            String
  occupation       String
  workplace        String
  educationLevel   String
  profession       String
  orgValue         String
  skills           String
  socialMedia      String
  medicalCondition String
  allergies        String
  signature        String
  declarationDate  String
  status           ApplicationStatus @default(NEW)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Donation {
  id             String         @id @default(cuid())
  monthlyAmount  Float
  months         Int
  total          Float
  currency       String         @default("USD")
  status         DonationStatus @default(PENDING)
  paypalOrderId  String         @unique
  payerEmail     String?
  payerName      String?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
}

model MonthlyPayout {
  id            String       @id @default(cuid())
  sellerId      String
  periodYm      String
  amountDue     Float
  status        PayoutStatus @default(PENDING)
  dueAt         DateTime
  transferredAt DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  seller        User         @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, periodYm])
}
