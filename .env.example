# Conexión PostgreSQL (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/valux?sslmode=require"

# Secreto de sesión para Auth.js — generar con: npx auth secret
AUTH_SECRET="cambia-esto"

# URL pública del sitio (en Vercel se detecta sola; necesaria en local)
# AUTH_URL="http://localhost:3000"
